# AWS Configuration
AWS_ACCESS_KEY_ID = "your AWS_Access_Key"
AWS_SECRET_ACCESS_KEY = "Your AWS_Secret_Access_key"
AWS_REGION="ap-southeast-2"
S3_BUCKET =atlas-enterprise-ai-015

# BEDROCK Model Configuration
BEDROCK_EMBED_MODEL = amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL = amazon.nova-lite-v1:0
EMBED_DIM = 1024

# PINECONE VectorDatabase Configuration
PINECONE_API_KEY = "your pinecone_api_key"
PINECONE_INDEX_HOST = "atlas-enterprise-ai-index"
PINECONE_CLOUD = aws
PINECONE_REGION = ap-southeast-2
PINECODE_READY_TIMEOUT = 180


# POSTGRESQL Database Configuration
DATABASE_URL= your postgresql database url

# RIUS Obserability Configuration
RIUS_API_KEY="your rius_api_key"
RIUS_SERVICE_NAME = atlas_ai_enterprise
RIUS_DISABLED = false 
RIUS_CAPTURE_CONTENT = false 