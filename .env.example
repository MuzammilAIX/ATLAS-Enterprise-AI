# ==========================================
# AWS Configuration (S3 only)
# ==========================================
# ⚠️ Locally only. In App Runner, do NOT set these — use an
# Instance Role with S3 permissions instead. Remove these two
# lines before deploying.
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="ap-southeast-2"

S3_BUCKET="atlas-enterprise-ai-015"


# ==========================================
# Embedding Configuration (OpenAI)
# ==========================================
EMBEDDING_PROVIDER="openai"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EMBED_DIM=384
EMBED_BATCH_SIZE=100

# Deprecated — kept only so existing config.py doesn't fail if it
# still reads these fields. Safe to remove once config.py is cleaned.
EMBEDDING_DEVICE="cpu"
NORMALIZE_EMBEDDINGS=true


# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_API_KEY="your_actual_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"


# ==========================================
# Pinecone Configuration
# ==========================================
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_HOST="your_new_384_dimension_index_host"
PINECONE_CLOUD="aws"
PINECONE_REGION=ap-southeast-2
PINECONE_READY_TIMEOUT=180


# ==========================================
# PostgreSQL Configuration
# ==========================================
DATABASE_URL="your_postgresql_database_url"


# ==========================================
# Rius Observability Configuration
# ==========================================
RIUS_API_KEY="your_rius_api_key"
RIUS_SERVICE_NAME="atlas_ai_enterprise"
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false


# ==========================================
# RAG Behaviour
# ==========================================
HITL_ENABLED=true
MEMORY_TURNS=6

# Relevance gate: retrieval results below this score are dropped.
# Higher = stricter (more refusals). Lower = looser (more hallucination risk).
# Start at 0.65, tune based on real query results.
MIN_RELEVANCE=0.65


# ==========================================
# Upload Limits
# ==========================================
MAX_UPLOAD_BYTES=26214400